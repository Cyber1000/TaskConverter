<?xml version="1.0" encoding="utf-8" ?>  
<configuration>   
  <appSettings>
    <add key="TimeZoneId" value="Europe/Vienna" />
    <add key="GTD.AllowIncompleteMappingIfMoreThanOneItem" value="true" />
    <!-- Where to read/write the app preferences of the GTD backup. Empty means they are dropped. -->
    <add key="GTD.PreferenceFilePath" value="" />
    <add key="GTD.IntermediateFormat.Symbol.Folder" value="+" />
    <add key="GTD.IntermediateFormat.Symbol.Context" value="@" />
    <add key="GTD.IntermediateFormat.Symbol.Status" value="#" />
    <add key="GTD.GTDFormat.Symbol.Folder" value="" />
    <add key="GTD.GTDFormat.Symbol.Context" value="@" />
    <add key="GTD.GTDFormat.Symbol.Status" value="#" />
  </appSettings>  
</configuration>